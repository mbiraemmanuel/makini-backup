# =============================================================================
# Dashboard Environment Variables
# Copy to .env.local and fill in values — never commit .env.local
# =============================================================================

# GCP project that holds the Secret Manager secrets
GCP_PROJECT_ID=makini-sf-backup-prod

# Service account JSON (base64-encoded) for the dashboard to authenticate
# with GCP Secret Manager and Google Drive.
# generate: base64 -w 0 sa-key.json
DASHBOARD_SA_JSON_B64=<base64-encoded-service-account-json>

# Path to the clients config directory (relative to repo root)
# Defaults to ../clients relative to the dashboard/ folder
CLIENTS_DIR=../clients

# Optional: restrict dashboard access with a shared secret header
# DASHBOARD_SECRET=change-me-in-production
