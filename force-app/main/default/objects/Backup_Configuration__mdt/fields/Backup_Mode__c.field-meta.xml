<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Backup_Mode__c</fullName>
    <description>Controls which components to back up. full = data + metadata + files. Use data for records only.</description>
    <externalId>false</externalId>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Backup Mode</label>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>full</fullName>
                <default>true</default>
                <label>Full (data + metadata + files)</label>
            </value>
            <value>
                <fullName>data</fullName>
                <default>false</default>
                <label>Data only</label>
            </value>
            <value>
                <fullName>metadata</fullName>
                <default>false</default>
                <label>Metadata only</label>
            </value>
            <value>
                <fullName>files</fullName>
                <default>false</default>
                <label>Files only</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
