<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>support@makiniconsulting.com</contactEmail>
    <description>Makini Consulting full-org backup solution. Uses JWT Bearer Flow to authenticate a headless integration user and export data/metadata to Google Drive via GCP Cloud Run.</description>
    <label>Makini SF Backup</label>

    <!-- ── OAuth / JWT Bearer ──────────────────────────────────────────────── -->
    <oauthConfig>
        <!-- Callback URL is required even for JWT-only apps -->
        <callbackUrl>https://login.salesforce.com/services/oauth2/success</callbackUrl>
        <!--
            IMPORTANT (post-install step):
            Upload your certificate.pem here after installing the package:
              Setup → App Manager → Makini SF Backup → Edit
              → Enable JWT Bearer Flow → Certificate Upload
        -->
        <isAdminApproved>true</isAdminApproved>
        <isConsumerSecretOptional>false</isConsumerSecretOptional>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
    </oauthConfig>

    <!-- ── Session / IP policy ────────────────────────────────────────────── -->
    <oauthPolicy>
        <!-- Relax IP enforcement — the integration runs from GCP Cloud Run IPs -->
        <ipRelaxation>BYPASS</ipRelaxation>
        <!-- JWT tokens are short-lived; no refresh tokens needed -->
        <refreshTokenPolicy>zero</refreshTokenPolicy>
    </oauthPolicy>

    <!-- ── Access policy: admin must explicitly approve per-user ──────────── -->
    <permissionSetName>Makini_Backup_Integration</permissionSetName>

</ConnectedApp>
